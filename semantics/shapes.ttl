# [R25] Export-Regulated Item EAR_EXPORT Policy (REJECT)
:RuleR25Shape a sh:NodeShape ;
    sh:targetClass :PurchaseOrderRequest ;
    sh:severity sh:Violation ;
    :ruleId "R25" ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "R25: ExportRegulatedItem (ExportControlledSoftware or dual_use_flg=1) requires valid, non-revoked EAR_EXPORT certification on req_dt." ;
        sh:prefixes :MeridianPrefixes ;
        sh:select """
            SELECT $this WHERE {
                $this :hasVendor ?v ;
                      :hasSKU ?sku ;
                      :reqDate ?dt .
                ?sku a :ExportRegulatedItem .
                FILTER NOT EXISTS {
                    ?v :hasCertificate ?c .
                    ?c :certType "EAR_EXPORT" ;
                       :isRevoked false ;
                       :validFrom ?vf ;
                       :validTo ?vt .
                    FILTER (?vf <= ?dt && ?dt <= ?vt)
                }
            }
        """ ;
    ] .

# [R26] Expedited Implantable Device VP Approval Policy (ESCALATE)
:RuleR26Shape a sh:NodeShape ;
    sh:targetClass :PurchaseOrderRequest ;
    sh:severity sh:Warning ;
    :ruleId "R26" ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "R26: Expedited PO for ImplantableDevice requires L3_VP approval." ;
        sh:prefixes :MeridianPrefixes ;
        sh:select """
            SELECT $this WHERE {
                $this :hasSKU ?sku ;
                      :isExpedited true ;
                      :approverLevel ?lvl .
                ?sku a :ImplantableDevice .
                FILTER (?lvl != "L3_VP")
            }
        """ ;
    ] .

# [R27] High-Value PO Approval Threshold Policy (ESCALATE)
:RuleR27Shape a sh:NodeShape ;
    sh:targetClass :PurchaseOrderRequest ;
    sh:severity sh:Warning ;
    :ruleId "R27" ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "R27: PO value exceeds approval authority threshold (>100k requires L2_DIR/L3_VP; >500k requires L3_VP)." ;
        sh:prefixes :MeridianPrefixes ;
        sh:select """
            SELECT $this WHERE {
                $this :poQty ?q ;
                      :poUnitPriceUsd ?p ;
                      :approverLevel ?lvl .
                BIND (?q * ?p AS ?val)
                FILTER (
                    (?val > 500000 && ?lvl != "L3_VP") ||
                    (?val > 100000 && ?lvl != "L2_DIR" && ?lvl != "L3_VP")
                )
            }
        """ ;
    ] .
